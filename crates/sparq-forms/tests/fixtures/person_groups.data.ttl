@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.org/> .

ex:eve a ex:Employee ;
  ex:fullName "Eve Example" ;
  ex:bio "Line one.\nLine two." ;
