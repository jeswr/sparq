kb:find-zk-circuit-gate a pkg:Finding ;
  rdfs:label "A ZK-circuit change re-runs forge_gates + differential_fuzz + the gate-count snapshot and re-opens the soundness audit"@en-GB ;
  pkg:about kb:topic-zk-discipline ;
  pkg:verdict sigimpl:yes ;
  sigimpl:justification "Touching sparq-zk / sparq-zk-compose re-runs forge_gates + differential_fuzz and the gate-count snapshot (gate_count.rs + gate_count_snapshot.json); snapshot_covers_top_level_circuits (Gate G5) and snapshot_covers_every_member fail without a toolchain if a new circuit lacks a baseline; re-baseline via bench/zk-compose/scripts/gate_counts.sh and re-open the soundness audit."@en-GB ;
  pkg:confidence 0.95 ;
  pkg:assurance secx:Claimed ;
  prov:wasDerivedFrom kb:doc-agents-md ;
  cito:citesAsEvidence kb:doc-agents-md ;
  dcterms:source "AGENTS.md#post-batch-re-evaluation-checklist--what-to-re-run-after-a-change" ;
  dcterms:subject kb:topic-zk-discipline ;
  dcterms:subject kb:topic-merge-discipline ;
  dqv:hasQualityMeasurement kb:meas-find-zk-circuit-gate-conf .

