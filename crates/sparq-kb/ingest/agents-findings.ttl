kb:find-merge-ci-summary-gate a pkg:Finding ;
  rdfs:label "A PR merges only when ci-summary is green and every review thread is resolved"@en-GB ;
  pkg:about kb:topic-merge-discipline ;
  pkg:verdict sigimpl:yes ;
  sigimpl:justification "Changes land on main via PRs, not direct push; the single required check is ci-summary (it aggregates every workflow and passes only when all pass); merge only when ci-summary is green AND all review threads — especially Copilot's — are resolved, then squash-merge and delete the branch."@en-GB ;
  pkg:confidence 0.98 ;
  pkg:assurance secx:Claimed ;
  prov:wasDerivedFrom kb:doc-agents-md ;
  cito:citesAsEvidence kb:doc-agents-md ;
  dcterms:source "AGENTS.md#contribution-workflow--prs-reviews-resolved-the-ci-summary-gate" ;
