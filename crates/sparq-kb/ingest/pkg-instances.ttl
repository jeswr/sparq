kb:find-zk-arming-model a pkg:Finding ;
  rdfs:label "A verified-clean non-perf PR auto-arms; never arm auto-merge on a stacked PR whose base is not main"@en-GB ;
  pkg:about kb:topic-merge-discipline ;
  pkg:verdict sigimpl:yes ;
  sigimpl:justification "Honesty/correctness/scope are automated by adversarial-verify + ci-summary, so a verified-clean, non-perf-affecting PR auto-arms; a perf-affecting PR gets the sparq-perf-reviewer PreToolUse gate before arming; and NEVER arm auto-merge on a stacked PR (base != main) — GitHub squash-merges it into the stacked base and its content never reaches main (enforced by scripts/check-pr-arm-base.py)."@en-GB ;
