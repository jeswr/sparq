  dqv:value 0.95 .

kb:find-zk-privacy-claims-gate a pkg:Finding ;
  rdfs:label "Any ZK/MPC privacy or soundness claim must stay hedged/negative — the privacy-claims gate is a HARD ci-summary job"@en-GB ;
  pkg:about kb:topic-zk-discipline ;
  pkg:verdict sigimpl:yes ;
  sigimpl:justification "The v1 ZK verifier is pending external accredited-cryptographer sign-off (sq-qhy4) and sparq-mpc is honest-majority semi-honest only, so no doc/README/SKILL/site line may state a ZK/MPC privacy-or-soundness property as settled fact without the not-yet-sound caveat; scripts/check-privacy-claims.sh (the HARD privacy-claims job in docs-quality.yml, gated by ci-summary) fails the build on an unhedged hit unless the line carries privacy-claims-allow: <why>."@en-GB ;
  pkg:confidence 0.97 ;
  pkg:assurance secx:Claimed ;
  prov:wasDerivedFrom kb:doc-agents-md ;
