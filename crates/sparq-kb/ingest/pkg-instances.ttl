  dcterms:isReferencedBy kb:skill-vector-search .

kb:skill-sparql-query a pkg:Source , pkg:Document , fabio:Expression ;
  dcterms:title "sparql-query skill — sparq surface guide" ;
  dcterms:identifier "skills/sparql-query/SKILL.md" ;
