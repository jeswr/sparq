// markdownlint-cli2 ADVISORY config — whole-repo visibility (bead sq-5fd1). [OPUS-4.8]
//
// Same tuned ruleset as the HARD config (.markdownlint-cli2.jsonc) but globbed over
// the corpus that is NOT yet under the HARD gate (bench/, .claude/, …). Run ONLY by
// the `markdownlint-advisory` job (continue-on-error) so any staged-rollout backlog in
// the not-yet-clean dirs stays visible without blocking merges. As those dirs are
// cleaned, fold them into the HARD config's `globs` and add them to `ignores` here.
//
// research/ + zk/ were cleaned and promoted to the HARD gate (sq-rqyo), so they are
// ignored below — the HARD job (markdownlint, no `--config`) now owns them; keeping
// them here too would only duplicate the (now-zero) report.
{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD034": false,
    "MD041": false,
    "MD025": false,
    "MD024": { "siblings_only": true },
    "MD036": false,
    "MD026": false,
    "MD029": false,
    "MD004": false,
    "MD049": false,
    "MD007": false,
    "MD046": false,
    "MD022": false,
    "MD031": false,
    "MD032": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules",
    "**/node_modules",
    "target",
    "**/target",
    "vendor",
    "**/vendor",
    // [OPUS-4.8] sq-5reoy: dropped the "zk/xpath/vendor" entry — the zk/xpath tree
    // moved to the sparq-org/noir_XPath face repo (#1599); "**/vendor" still covers
    // any remaining vendored subtree, and "zk" below already excludes zk/ wholesale.
    // sq-rqyo: research/ + zk/ are now HARD-gated — exclude here to avoid double-reporting.
    "research",
    "zk"
  ]
}
