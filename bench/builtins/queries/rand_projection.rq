# [GPT-5.6] Forces several RAND evaluations for every materialized input binding.
SELECT ?s
  (RAND() AS ?random0) (RAND() AS ?random1)
  (RAND() AS ?random2) (RAND() AS ?random3)
  (RAND() AS ?random4) (RAND() AS ?random5)
  (RAND() AS ?random6) (RAND() AS ?random7)
WHERE {
  ?s <urn:value> ?value .
}
