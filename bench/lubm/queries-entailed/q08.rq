# [OPUS-4.8] LUBM Q8 — ENTAILED (Student closure, see Q6). Students who are members of a
# department that is a sub-organization of University0, with their email. Needs the full
# Student classification; 0 without reasoning.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX ub: <http://swat.cse.lehigh.edu/onto/univ-bench.owl#>
SELECT ?x ?y ?z WHERE {
  ?x rdf:type ub:Student .
  ?y rdf:type ub:Department .
  ?x ub:memberOf ?y .
  ?y ub:subOrganizationOf <http://www.University0.edu> .
  ?x ub:emailAddress ?z .
}
