# [OPUS-4.8] WatDiv Basic-Testing S4 (Star). Placeholder %v1% (wsdbm:AgeGroup)
# instantiated to wsdbm:AgeGroup7.
# DEVIATION (documented in README): the canonical embedded constant is
# `sorg:nationality wsdbm:Country1`, which yields no match with the age+familyName+
# mo:artist star at SF=1. We use wsdbm:Country8 (the nationality that DOES co-occur
# with this star at SF=1) so the shape stays non-empty and stable. The
# canonical-constant form lives in queries-heavy/ for the SF=1000 EC2/nightly tier.
PREFIX foaf:  <http://xmlns.com/foaf/>
PREFIX mo:    <http://purl.org/ontology/mo/>
PREFIX sorg:  <http://schema.org/>
PREFIX wsdbm: <http://db.uwaterloo.ca/~galuc/wsdbm/>
SELECT ?v0 ?v2 ?v3 WHERE {
  ?v0 foaf:age wsdbm:AgeGroup7 .
  ?v0 foaf:familyName ?v2 .
  ?v3 mo:artist ?v0 .
  ?v0 sorg:nationality wsdbm:Country8 .
}
