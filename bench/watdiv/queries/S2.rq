# [OPUS-4.8] WatDiv Basic-Testing S2 (Star). Placeholder %v2% (wsdbm:Country)
# instantiated to wsdbm:Country0 (exists at SF=1; yields a small stable result).
PREFIX dc:    <http://purl.org/dc/terms/>
PREFIX sorg:  <http://schema.org/>
PREFIX wsdbm: <http://db.uwaterloo.ca/~galuc/wsdbm/>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?v0 ?v1 ?v3 WHERE {
  ?v0 dc:Location ?v1 .
  ?v0 sorg:nationality wsdbm:Country0 .
  ?v0 wsdbm:gender ?v3 .
  ?v0 rdf:type wsdbm:Role2 .
}
