# [OPUS-4.8] WatDiv Basic-Testing C3 (Complex). No placeholder: a 6-pattern star over
# the wsdbm:User profile (likes/friendOf/Location/age/gender/givenName). Verbatim
# canonical template; non-empty and stable at SF=1.
PREFIX dc:    <http://purl.org/dc/terms/>
PREFIX foaf:  <http://xmlns.com/foaf/>
PREFIX wsdbm: <http://db.uwaterloo.ca/~galuc/wsdbm/>
SELECT ?v0 WHERE {
  ?v0 wsdbm:likes ?v1 .
  ?v0 wsdbm:friendOf ?v2 .
  ?v0 dc:Location ?v3 .
  ?v0 foaf:age ?v4 .
  ?v0 wsdbm:gender ?v5 .
  ?v0 foaf:givenName ?v6 .
}
