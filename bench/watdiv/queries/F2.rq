# [OPUS-4.8] WatDiv Basic-Testing F2 (Snowflake). Placeholder %v8% (wsdbm:SubGenre)
# instantiated to wsdbm:SubGenre43 (lowest-id SubGenre with a non-empty F2 snowflake at
# SF=1; yields a stable result).
PREFIX foaf:  <http://xmlns.com/foaf/>
PREFIX og:    <http://ogp.me/ns#>
PREFIX sorg:  <http://schema.org/>
PREFIX wsdbm: <http://db.uwaterloo.ca/~galuc/wsdbm/>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?v0 ?v1 ?v2 ?v4 ?v5 ?v6 ?v7 WHERE {
  ?v0 foaf:homepage ?v1 .
  ?v0 og:title ?v2 .
  ?v0 rdf:type ?v3 .
  ?v0 sorg:caption ?v4 .
  ?v0 sorg:description ?v5 .
  ?v1 sorg:url ?v6 .
  ?v1 wsdbm:hits ?v7 .
  ?v0 wsdbm:hasGenre wsdbm:SubGenre43 .
}
