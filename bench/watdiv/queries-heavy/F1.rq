# [OPUS-4.8] WatDiv Basic-Testing F1 (Snowflake) — EC2/nightly tier (SF>=10).
# Placeholder %v1% (wsdbm:Topic) instantiated to wsdbm:Topic3.
# EMPTY at the per-commit SF=1 scale: the canonical arm `?v3 sorg:trailer ?v4` has NO
# matching triples at SF=1 (sorg:trailer is too rare to appear in ~100k triples), so the
# whole snowflake is unsatisfiable there. The template populates at scale (verified
# non-empty at SF=10: PC2 + Topic3 yields rows). Lives here, NOT in queries/, so the
# per-commit suite stays all-non-empty; run at SF=1000 on the EC2/nightly tier.
PREFIX og:    <http://ogp.me/ns#>
PREFIX sorg:  <http://schema.org/>
PREFIX wsdbm: <http://db.uwaterloo.ca/~galuc/wsdbm/>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?v0 ?v2 ?v3 ?v4 ?v5 WHERE {
  ?v0 og:tag wsdbm:Topic3 .
  ?v0 rdf:type ?v2 .
  ?v3 sorg:trailer ?v4 .
  ?v3 sorg:keywords ?v5 .
  ?v3 wsdbm:hasGenre ?v0 .
  ?v3 rdf:type wsdbm:ProductCategory2 .
}
