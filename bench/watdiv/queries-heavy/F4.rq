# [OPUS-4.8] WatDiv Basic-Testing F4 (Snowflake) — EC2/nightly tier (SF>=10).
# Placeholder %v3% (wsdbm:Topic) instantiated to wsdbm:Topic3.
# EMPTY at the per-commit SF=1 scale: the compound join (a product with
# homepage+description+contentSize whose homepage simultaneously has url+hits+
# language Language0, that is also gr:included, og:tagged, and wsdbm:liked) has no
# solution in ~100k triples. Populates at scale (verified non-empty at SF=10 with
# Topic3). Lives here so the per-commit suite stays all-non-empty; run at SF=1000.
PREFIX foaf:  <http://xmlns.com/foaf/>
PREFIX gr:    <http://purl.org/goodrelations/>
PREFIX og:    <http://ogp.me/ns#>
PREFIX sorg:  <http://schema.org/>
PREFIX wsdbm: <http://db.uwaterloo.ca/~galuc/wsdbm/>
SELECT ?v0 ?v1 ?v2 ?v4 ?v5 ?v6 ?v7 ?v8 WHERE {
  ?v0 foaf:homepage ?v1 .
  ?v2 gr:includes ?v0 .
  ?v0 og:tag wsdbm:Topic3 .
  ?v0 sorg:description ?v4 .
  ?v0 sorg:contentSize ?v8 .
  ?v1 sorg:url ?v5 .
  ?v1 wsdbm:hits ?v6 .
  ?v1 sorg:language wsdbm:Language0 .
  ?v7 wsdbm:likes ?v0 .
}
