<?xml version="1.0" encoding="UTF-8"?>
<!-- [FABLE-5] sq-hmd7l.24 — sparq-AUTHORED vendored case (NOT a W3C file). A valid
     document carrying an <Import> directive. The importer fail-closes on remote
     imports, so the PINNED verdict is skip:imports — a completeness gap surfaced
     honestly in the taxonomy, never laundered into a pass or a fail. -->
<Document xmlns="http://www.w3.org/2007/rif#">
  <directive>
    <Import>
      <location>http://example.org/imported-ruleset</location>
    </Import>
  </directive>
  <payload>
    <Group>
      <sentences>
        <Frame>
          <object><Const type="http://www.w3.org/2007/rif#iri">http://example.org/a</Const></object>
          <slot>
            <Const type="http://www.w3.org/2007/rif#iri">http://example.org/p</Const>
            <Const type="http://www.w3.org/2007/rif#iri">http://example.org/b</Const>
          </slot>
        </Frame>
      </sentences>
    </Group>
  </payload>
</Document>
