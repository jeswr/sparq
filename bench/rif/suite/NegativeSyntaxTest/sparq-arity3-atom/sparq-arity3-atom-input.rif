<?xml version="1.0" encoding="UTF-8"?>
<!-- [FABLE-5] sq-hmd7l.24 — sparq-AUTHORED vendored case (NOT a W3C file). The body
     uses an arity-3 positional Atom, a construct OUTSIDE the importer's supported
     subset (only arity-1/2 have a sound mapping). The importer rejects it — but ONLY
     because it is unsupported, which must NOT launder into a "correctly rejected":
     the PINNED verdict is skip:condition-shape (the syntax-polarity vacuity guard). -->
<Document xmlns="http://www.w3.org/2007/rif#">
  <payload>
    <Group>
      <sentences>
        <Forall>
          <declare><Var>x</Var></declare>
          <formula>
            <Implies>
              <if>
                <Atom>
                  <op><Const type="http://www.w3.org/2007/rif#iri">http://example.org/between</Const></op>
                  <args ordered="yes">
                    <Var>x</Var>
                    <Const type="http://www.w3.org/2007/rif#iri">http://example.org/a</Const>
                    <Const type="http://www.w3.org/2007/rif#iri">http://example.org/b</Const>
                  </args>
                </Atom>
              </if>
              <then>
                <Frame>
                  <object><Var>x</Var></object>
                  <slot>
                    <Const type="http://www.w3.org/2007/rif#iri">http://example.org/q</Const>
                    <Var>x</Var>
                  </slot>
                </Frame>
              </then>
            </Implies>
          </formula>
        </Forall>
      </sentences>
    </Group>
  </payload>
</Document>
