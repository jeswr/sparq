<?xml version="1.0" encoding="UTF-8"?>
<!-- [FABLE-5] sq-hmd7l.24 — sparq-AUTHORED vendored case (NOT a W3C file). An UNSAFE
     (non-range-restricted) rule: head variable ?y never occurs in the body. The
     validator GENUINELY detects this modelled Core violation (UnboundHeadVar), so the
     rejection is a NON-vacuous pass. -->
<Document xmlns="http://www.w3.org/2007/rif#">
  <payload>
    <Group>
      <sentences>
        <Forall>
          <declare><Var>x</Var></declare>
          <declare><Var>y</Var></declare>
          <formula>
            <Implies>
              <if>
                <Frame>
                  <object><Var>x</Var></object>
                  <slot>
                    <Const type="http://www.w3.org/2007/rif#iri">http://example.org/p</Const>
                    <Var>x</Var>
                  </slot>
                </Frame>
              </if>
              <then>
                <Frame>
                  <object><Var>x</Var></object>
                  <slot>
                    <Const type="http://www.w3.org/2007/rif#iri">http://example.org/q</Const>
                    <Var>y</Var>
                  </slot>
                </Frame>
              </then>
            </Implies>
          </formula>
        </Forall>
      </sentences>
    </Group>
  </payload>
</Document>
