<?xml version="1.0" encoding="UTF-8"?>
<!-- [FABLE-5] sq-hmd7l.24 — sparq-AUTHORED vendored case (NOT a W3C file). Membership
     chain: socrates # Human plus the rule ?x # Human => ?x # Mortal must entail
     socrates # Mortal. -->
<Document xmlns="http://www.w3.org/2007/rif#">
  <payload>
    <Group>
      <sentences>
        <Member>
          <instance><Const type="http://www.w3.org/2007/rif#iri">http://example.org/socrates</Const></instance>
          <class><Const type="http://www.w3.org/2007/rif#iri">http://example.org/Human</Const></class>
        </Member>
        <Forall>
          <declare><Var>x</Var></declare>
          <formula>
            <Implies>
              <if>
                <Member>
                  <instance><Var>x</Var></instance>
                  <class><Const type="http://www.w3.org/2007/rif#iri">http://example.org/Human</Const></class>
                </Member>
              </if>
              <then>
                <Member>
                  <instance><Var>x</Var></instance>
                  <class><Const type="http://www.w3.org/2007/rif#iri">http://example.org/Mortal</Const></class>
                </Member>
              </then>
            </Implies>
          </formula>
        </Forall>
      </sentences>
    </Group>
  </payload>
</Document>
