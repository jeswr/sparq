<?xml version="1.0" encoding="UTF-8"?>
<!-- [FABLE-5] sq-hmd7l.24 — sparq-AUTHORED vendored case (NOT a W3C file). The rule
     ?x[p->?y] => ?x[q->?y] over a[p->b] must NOT entail the converse b[q->a]. The
     premise imports+validates+closes, so the non-entailment verdict is NON-vacuous
     (the NET vacuity rule). -->
<Document xmlns="http://www.w3.org/2007/rif#">
  <payload>
    <Group>
      <sentences>
        <Frame>
          <object><Const type="http://www.w3.org/2007/rif#iri">http://example.org/a</Const></object>
          <slot>
            <Const type="http://www.w3.org/2007/rif#iri">http://example.org/p</Const>
            <Const type="http://www.w3.org/2007/rif#iri">http://example.org/b</Const>
          </slot>
        </Frame>
        <Forall>
          <declare><Var>x</Var></declare>
          <declare><Var>y</Var></declare>
          <formula>
            <Implies>
              <if>
                <Frame>
                  <object><Var>x</Var></object>
                  <slot>
                    <Const type="http://www.w3.org/2007/rif#iri">http://example.org/p</Const>
                    <Var>y</Var>
                  </slot>
                </Frame>
              </if>
              <then>
                <Frame>
                  <object><Var>x</Var></object>
                  <slot>
                    <Const type="http://www.w3.org/2007/rif#iri">http://example.org/q</Const>
                    <Var>y</Var>
                  </slot>
                </Frame>
              </then>
            </Implies>
          </formula>
        </Forall>
      </sentences>
    </Group>
  </payload>
</Document>
