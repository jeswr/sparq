# Qleverfile for Olympics, use with https://github.com/ad-freiburg/qlever-control
#
# qlever get-data  # downloads .zip file of size 13 MB, uncompressed to 323 MB 
# qlever index     # takes ~10 seconds and ~1 GB RAM (on an AMD Ryzen 9 5900X)
# qlever start     # starts the server (instant)

[data]
NAME              = olympics
BASE_URL          = https://github.com/wallscope/olympics-rdf
GET_DATA_CMD      = curl -sLo olympics.zip -C - ${BASE_URL}/raw/master/data/olympics-nt-nodup.zip && unzip -q -o olympics.zip && rm olympics.zip
DESCRIPTION       = 120 Years of Olympics, data from ${BASE_URL}
TEXT_DESCRIPTION  = All literals, search with FILTER CONTAINS(?var, "...")

[index]
INPUT_FILES     = olympics.nt
CAT_INPUT_FILES = cat ${INPUT_FILES}
SETTINGS_JSON   = { "ascii-prefixes-only": false, "num-triples-per-batch": 100000 }

[server]
PORT               = 7019
ACCESS_TOKEN       = ${data:NAME}_7643543846eFq6lneiscnp
MEMORY_FOR_QUERIES = 5G
CACHE_MAX_SIZE     = 2G
TIMEOUT            = 30s

[runtime]
SYSTEM = native
# [OPUS-4.8] sq-l9yt: pinned by sha256 digest for reproducibility (was :latest).
# This is the multi-arch manifest-list (OCI index) digest of adfreiburg/qlever:latest
# resolved 2026-06-17; it is what `docker pull` resolves and what `docker inspect
# --format '{{index .RepoDigests 0}}'` records (see scripts/gather-competitors.sh).
# Re-pin only deliberately (record the new digest in bench/competitors.json too).
IMAGE  = docker.io/adfreiburg/qlever@sha256:6fb9ce89e6461607e0826872369ad09c48e96b4c6faffc3f0c8133001858c29b

[ui]
UI_CONFIG = olympics
