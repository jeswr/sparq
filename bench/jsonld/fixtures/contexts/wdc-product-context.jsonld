{
  "@context": {
    "@vocab": "http://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "gtin13": {
      "@id": "http://schema.org/gtin13"
    },
    "price": {
      "@id": "http://schema.org/price",
