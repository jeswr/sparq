# [SONNET-4.6] sq-enfy3 — Jena-indexed rendering of the `within10km`
# workload. This query runs only against the feature-modelled corpus variant
# from bench/geo/gen.sh; the fixed direct geo:asWKT corpus and its oracle stay
# unchanged. Jena's property function uses latitude-longitude argument order
# and kilometres, and returns the owning feature through its spatial index.
# Oracle: COUNT must equal expected.tsv `within10km` before timing is trusted.
PREFIX spatial: <http://jena.apache.org/spatial#>
SELECT (COUNT(?e) AS ?n) WHERE {
  ?e spatial:withinCircle (51 0 10 "km") .
}
