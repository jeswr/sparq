/// fn:string-length — CODEPOINTS, not bytes, and stopping at the NUL terminator.
/// Oracle: SPARQL `STRLEN(<literal>)`.
#[test]
fn differential_oracle_string_length() {
    // STRLEN("hello") -> 5
    let s0: str<5> = "hello";
    assert(string_length::<5>(s0) == 5);
    // STRLEN("") -> 0
    let s1: str<0> = "";
    assert(string_length::<0>(s1) == 0);
    // STRLEN("hello") -> 5
    let s2: str<10> = "hello\0\0\0\0\0";
    assert(string_length::<10>(s2) == 5);
    // STRLEN("é") -> 1
    let s3: str<2> = "é";
    assert(string_length::<2>(s3) == 1);
    // STRLEN("aé") -> 2
    let s4: str<3> = "aé";
    assert(string_length::<3>(s4) == 2);
    // STRLEN("naïve") -> 5
    let s5: str<6> = "naïve";
    assert(string_length::<6>(s5) == 5);
    // STRLEN("日本語") -> 3
    let s6: str<9> = "日本語";
    assert(string_length::<9>(s6) == 3);
    // STRLEN("𝄞") -> 1
    let s7: str<4> = "𝄞";
    assert(string_length::<4>(s7) == 1);
    // STRLEN("é") -> 2
    let s8: str<3> = "é";
    assert(string_length::<3>(s8) == 2);
    // STRLEN("ﬀ") -> 1
    let s9: str<3> = "ﬀ";
    assert(string_length::<3>(s9) == 1);
    // STRLEN("日本語") -> 3
    let s10: str<15> = "日本語\0\0\0\0\0\0";
    assert(string_length::<15>(s10) == 3);
}

/// fn:starts-with — oracle: SPARQL `STRSTARTS`.
#[test]
fn differential_oracle_starts_with() {
    // STRSTARTS("hello", "ell") -> false
    let h0: str<5> = "hello";
    let n0: str<3> = "ell";
    assert(starts_with::<5, 3>(h0, n0) == false);
    // STRSTARTS("hello", "hel") -> true
    let h1: str<5> = "hello";
    let n1: str<3> = "hel";
    assert(starts_with::<5, 3>(h1, n1) == true);
    // STRSTARTS("hello", "llo") -> false
    let h2: str<5> = "hello";
    let n2: str<3> = "llo";
    assert(starts_with::<5, 3>(h2, n2) == false);
    // STRSTARTS("hello", "") -> true
    let h3: str<5> = "hello";
    let n3: str<0> = "";
    assert(starts_with::<5, 0>(h3, n3) == true);
    // STRSTARTS("hello", "zzz") -> false
    let h4: str<5> = "hello";
    let n4: str<3> = "zzz";
    assert(starts_with::<5, 3>(h4, n4) == false);
    // STRSTARTS("hello", "llo") -> false
    let h5: str<10> = "hello\0\0\0\0\0";
    let n5: str<3> = "llo";
    assert(starts_with::<10, 3>(h5, n5) == false);
    // STRSTARTS("hello", "llo") -> false
    let h6: str<5> = "hello";
    let n6: str<6> = "llo\0\0\0";
    assert(starts_with::<5, 6>(h6, n6) == false);
    // STRSTARTS("hello", "hell") -> true
    let h7: str<10> = "hello\0\0\0\0\0";
    let n7: str<4> = "hell";
    assert(starts_with::<10, 4>(h7, n7) == true);
    // STRSTARTS("naïve", "ï") -> false
    let h8: str<6> = "naïve";
    let n8: str<2> = "ï";
    assert(starts_with::<6, 2>(h8, n8) == false);
    // STRSTARTS("naïve", "na") -> true
    let h9: str<6> = "naïve";
    let n9: str<2> = "na";
    assert(starts_with::<6, 2>(h9, n9) == true);
    // STRSTARTS("naïve", "ve") -> false
    let h10: str<6> = "naïve";
    let n10: str<2> = "ve";
    assert(starts_with::<6, 2>(h10, n10) == false);
    // STRSTARTS("日本語", "本") -> false
    let h11: str<9> = "日本語";
    let n11: str<3> = "本";
    assert(starts_with::<9, 3>(h11, n11) == false);
    // STRSTARTS("日本語", "日") -> true
    let h12: str<9> = "日本語";
    let n12: str<3> = "日";
    assert(starts_with::<9, 3>(h12, n12) == true);
    // STRSTARTS("日本語", "語") -> false
    let h13: str<9> = "日本語";
    let n13: str<3> = "語";
    assert(starts_with::<9, 3>(h13, n13) == false);
    // STRSTARTS("𝄞", "𝄞") -> true
    let h14: str<4> = "𝄞";
    let n14: str<4> = "𝄞";
    assert(starts_with::<4, 4>(h14, n14) == true);
    // STRSTARTS("lo", "hello") -> false
    let h15: str<10> = "lo\0\0\0\0\0\0\0\0";
    let n15: str<5> = "hello";
    assert(starts_with::<10, 5>(h15, n15) == false);
}

/// fn:ends-with — oracle: SPARQL `STRENDS`.
#[test]
fn differential_oracle_ends_with() {
    // STRENDS("hello", "ell") -> false
    let h0: str<5> = "hello";
    let n0: str<3> = "ell";
    assert(ends_with::<5, 3>(h0, n0) == false);
    // STRENDS("hello", "hel") -> false
    let h1: str<5> = "hello";
    let n1: str<3> = "hel";
    assert(ends_with::<5, 3>(h1, n1) == false);
    // STRENDS("hello", "llo") -> true
    let h2: str<5> = "hello";
    let n2: str<3> = "llo";
    assert(ends_with::<5, 3>(h2, n2) == true);
    // STRENDS("hello", "") -> true
    let h3: str<5> = "hello";
    let n3: str<0> = "";
    assert(ends_with::<5, 0>(h3, n3) == true);
    // STRENDS("hello", "zzz") -> false
    let h4: str<5> = "hello";
    let n4: str<3> = "zzz";
    assert(ends_with::<5, 3>(h4, n4) == false);
    // STRENDS("hello", "llo") -> true
    let h5: str<10> = "hello\0\0\0\0\0";
    let n5: str<3> = "llo";
    assert(ends_with::<10, 3>(h5, n5) == true);
    // STRENDS("hello", "llo") -> true
    let h6: str<5> = "hello";
    let n6: str<6> = "llo\0\0\0";
    assert(ends_with::<5, 6>(h6, n6) == true);
    // STRENDS("hello", "hell") -> false
    let h7: str<10> = "hello\0\0\0\0\0";
    let n7: str<4> = "hell";
    assert(ends_with::<10, 4>(h7, n7) == false);
    // STRENDS("naïve", "ï") -> false
    let h8: str<6> = "naïve";
    let n8: str<2> = "ï";
    assert(ends_with::<6, 2>(h8, n8) == false);
    // STRENDS("naïve", "na") -> false
    let h9: str<6> = "naïve";
    let n9: str<2> = "na";
    assert(ends_with::<6, 2>(h9, n9) == false);
    // STRENDS("naïve", "ve") -> true
    let h10: str<6> = "naïve";
    let n10: str<2> = "ve";
    assert(ends_with::<6, 2>(h10, n10) == true);
    // STRENDS("日本語", "本") -> false
    let h11: str<9> = "日本語";
    let n11: str<3> = "本";
    assert(ends_with::<9, 3>(h11, n11) == false);
    // STRENDS("日本語", "日") -> false
    let h12: str<9> = "日本語";
    let n12: str<3> = "日";
    assert(ends_with::<9, 3>(h12, n12) == false);
    // STRENDS("日本語", "語") -> true
    let h13: str<9> = "日本語";
    let n13: str<3> = "語";
    assert(ends_with::<9, 3>(h13, n13) == true);
    // STRENDS("𝄞", "𝄞") -> true
    let h14: str<4> = "𝄞";
    let n14: str<4> = "𝄞";
    assert(ends_with::<4, 4>(h14, n14) == true);
    // STRENDS("lo", "hello") -> false
    let h15: str<10> = "lo\0\0\0\0\0\0\0\0";
    let n15: str<5> = "hello";
    assert(ends_with::<10, 5>(h15, n15) == false);
}

/// fn:contains — oracle: SPARQL `CONTAINS`.
#[test]
fn differential_oracle_contains() {
    // CONTAINS("hello", "ell") -> true
    let h0: str<5> = "hello";
    let n0: str<3> = "ell";
    assert(contains::<5, 3>(h0, n0) == true);
    // CONTAINS("hello", "hel") -> true
    let h1: str<5> = "hello";
    let n1: str<3> = "hel";
    assert(contains::<5, 3>(h1, n1) == true);
    // CONTAINS("hello", "llo") -> true
    let h2: str<5> = "hello";
    let n2: str<3> = "llo";
    assert(contains::<5, 3>(h2, n2) == true);
    // CONTAINS("hello", "") -> true
    let h3: str<5> = "hello";
    let n3: str<0> = "";
    assert(contains::<5, 0>(h3, n3) == true);
    // CONTAINS("hello", "zzz") -> false
    let h4: str<5> = "hello";
    let n4: str<3> = "zzz";
    assert(contains::<5, 3>(h4, n4) == false);
    // CONTAINS("hello", "llo") -> true
    let h5: str<10> = "hello\0\0\0\0\0";
    let n5: str<3> = "llo";
    assert(contains::<10, 3>(h5, n5) == true);
    // CONTAINS("hello", "llo") -> true
    let h6: str<5> = "hello";
    let n6: str<6> = "llo\0\0\0";
    assert(contains::<5, 6>(h6, n6) == true);
    // CONTAINS("hello", "hell") -> true
    let h7: str<10> = "hello\0\0\0\0\0";
    let n7: str<4> = "hell";
    assert(contains::<10, 4>(h7, n7) == true);
    // CONTAINS("naïve", "ï") -> true
    let h8: str<6> = "naïve";
    let n8: str<2> = "ï";
    assert(contains::<6, 2>(h8, n8) == true);
    // CONTAINS("naïve", "na") -> true
    let h9: str<6> = "naïve";
    let n9: str<2> = "na";
    assert(contains::<6, 2>(h9, n9) == true);
    // CONTAINS("naïve", "ve") -> true
    let h10: str<6> = "naïve";
    let n10: str<2> = "ve";
    assert(contains::<6, 2>(h10, n10) == true);
    // CONTAINS("日本語", "本") -> true
    let h11: str<9> = "日本語";
    let n11: str<3> = "本";
    assert(contains::<9, 3>(h11, n11) == true);
    // CONTAINS("日本語", "日") -> true
    let h12: str<9> = "日本語";
    let n12: str<3> = "日";
    assert(contains::<9, 3>(h12, n12) == true);
    // CONTAINS("日本語", "語") -> true
    let h13: str<9> = "日本語";
    let n13: str<3> = "語";
    assert(contains::<9, 3>(h13, n13) == true);
    // CONTAINS("𝄞", "𝄞") -> true
    let h14: str<4> = "𝄞";
    let n14: str<4> = "𝄞";
    assert(contains::<4, 4>(h14, n14) == true);
    // CONTAINS("lo", "hello") -> false
    let h15: str<10> = "lo\0\0\0\0\0\0\0\0";
    let n15: str<5> = "hello";
    assert(contains::<10, 5>(h15, n15) == false);
}

/// fn:substring — ASCII-only (see the byte-vs-codepoint scope limit above).
/// Oracle: SPARQL `SUBSTR`, cross-checked against the F&O 5.4.3 window. The `start < 1`
/// rows are SPEC-REFERENCE (see the header): sparq-engine shifts the window, so their
/// expected value is F&O's, and they assert noir_XPath against the SPEC.
#[test]
fn differential_oracle_substring() {
    // SUBSTR("hello", 2, 3) -> "ell"
    let ss0: str<5> = "hello";
    let (out0, len0) = substring::<5, 5>(ss0, 2, 3);
    assert(len0 == 3);
    assert(out0[0] == 101);
    assert(out0[1] == 108);
    assert(out0[2] == 108);
    // SUBSTR("hello", 1, 5) -> "hello"
    let ss1: str<5> = "hello";
    let (out1, len1) = substring::<5, 5>(ss1, 1, 5);
    assert(len1 == 5);
    assert(out1[0] == 104);
    assert(out1[1] == 101);
    assert(out1[2] == 108);
    assert(out1[3] == 108);
    assert(out1[4] == 111);
    // SUBSTR("hello", 1, 100) -> "hello"
    let ss2: str<5> = "hello";
    let (out2, len2) = substring::<5, 5>(ss2, 1, 100);
    assert(len2 == 5);
    assert(out2[0] == 104);
    assert(out2[1] == 101);
    assert(out2[2] == 108);
    assert(out2[3] == 108);
    assert(out2[4] == 111);
    // SUBSTR("hello", 3, 0) -> ""
    let ss3: str<5> = "hello";
    let (_out3, len3) = substring::<5, 5>(ss3, 3, 0);
    assert(len3 == 0);
    // SUBSTR("hello", 7, 3) -> ""
    let ss4: str<5> = "hello";
    let (_out4, len4) = substring::<5, 5>(ss4, 7, 3);
    assert(len4 == 0);
    // SUBSTR("hello", 5, 1) -> "o"
    let ss5: str<5> = "hello";
    let (out5, len5) = substring::<5, 5>(ss5, 5, 1);
    assert(len5 == 1);
    assert(out5[0] == 111);
    // SUBSTR("hello", 2, 3) -> "ell"
    let ss6: str<10> = "hello\0\0\0\0\0";
    let (out6, len6) = substring::<10, 10>(ss6, 2, 3);
    assert(len6 == 3);
    assert(out6[0] == 101);
    assert(out6[1] == 108);
    assert(out6[2] == 108);
    // SPEC-REFERENCE (start < 1): sparq-engine says "123", F&O 5.4.3 says
    // "12". noir_XPath is correct here (sq-3x7dl.6) and the oracle is not, so
    // the row asserts the SPEC value LIVE — it holds noir_XPath to F&O, not to sparq.
    // Drop the special-casing (not the assertion) when the engine is fixed.
    // SUBSTR("12345", 0, 3) -> "12"
    let ss7: str<5> = "12345";
    let (out7, len7) = substring::<5, 5>(ss7, 0, 3);
    assert(len7 == 2);
    assert(out7[0] == 49);
    assert(out7[1] == 50);
    // SPEC-REFERENCE (start < 1): sparq-engine says "hell", F&O 5.4.3 says
    // "h". noir_XPath is correct here (sq-3x7dl.6) and the oracle is not, so
    // the row asserts the SPEC value LIVE — it holds noir_XPath to F&O, not to sparq.
    // Drop the special-casing (not the assertion) when the engine is fixed.
    // SUBSTR("hello", -2, 4) -> "h"
    let ss8: str<5> = "hello";
    let (out8, len8) = substring::<5, 5>(ss8, -2, 4);
    assert(len8 == 1);
    assert(out8[0] == 104);
    // SPEC-REFERENCE (start < 1): sparq-engine says "12345", F&O 5.4.3 says
    // "1". noir_XPath is correct here (sq-3x7dl.6) and the oracle is not, so
    // the row asserts the SPEC value LIVE — it holds noir_XPath to F&O, not to sparq.
    // Drop the special-casing (not the assertion) when the engine is fixed.
    // SUBSTR("12345", -3, 5) -> "1"
    let ss9: str<5> = "12345";
    let (out9, len9) = substring::<5, 5>(ss9, -3, 5);
    assert(len9 == 1);
    assert(out9[0] == 49);
    // SPEC-REFERENCE (start < 1): sparq-engine says "hel", F&O 5.4.3 says
    // "". noir_XPath is correct here (sq-3x7dl.6) and the oracle is not, so
    // the row asserts the SPEC value LIVE — it holds noir_XPath to F&O, not to sparq.
    // Drop the special-casing (not the assertion) when the engine is fixed.
    // SUBSTR("hello", -100, 3) -> ""
    let ss10: str<5> = "hello";
    let (_out10, len10) = substring::<5, 5>(ss10, -100, 3);
    assert(len10 == 0);
}

/// op:numeric-divide on two xs:integer operands — the DECIMAL quotient (F&O 4.2.6),
/// implemented as the documented double approximation, and DISTINCT from
/// op:numeric-integer-divide (sq-3x7dl.4 de-aliasing). Oracle: SPARQL double
/// division of the promoted operands, bit-cross-checked against native f64.
///
/// The `numeric_divide_int` (idiv) rows are the DE-ALIASING control and are NOT
/// oracle-derived — SPARQL exposes no `idiv` builtin, so their reference is Rust's
/// integer division, which truncates toward zero exactly as F&O 4.2.5 requires.
#[test]
fn differential_oracle_numeric_divide() {
    // xsd:double("7") / xsd:double("2") -> bits 0x400c000000000000 as u64
    assert(numeric_divide_int_as_double(7, 2).to_bits() == 0x400c000000000000 as u64);
    assert(numeric_divide_int(7, 2) == 3);
    // xsd:double("1") / xsd:double("3") -> bits 0x3fd5555555555555 as u64
    assert(numeric_divide_int_as_double(1, 3).to_bits() == 0x3fd5555555555555 as u64);
    assert(numeric_divide_int(1, 3) == 0);
    // xsd:double("10") / xsd:double("5") -> bits 0x4000000000000000 as u64
    assert(numeric_divide_int_as_double(10, 5).to_bits() == 0x4000000000000000 as u64);
    assert(numeric_divide_int(10, 5) == 2);
    // xsd:double("-7") / xsd:double("2") -> bits 0xc00c000000000000 as u64
    assert(numeric_divide_int_as_double(-7, 2).to_bits() == 0xc00c000000000000 as u64);
    assert(numeric_divide_int(-7, 2) == -3);
    // xsd:double("7") / xsd:double("-2") -> bits 0xc00c000000000000 as u64
    assert(numeric_divide_int_as_double(7, -2).to_bits() == 0xc00c000000000000 as u64);
    assert(numeric_divide_int(7, -2) == -3);
    // xsd:double("-7") / xsd:double("-2") -> bits 0x400c000000000000 as u64
    assert(numeric_divide_int_as_double(-7, -2).to_bits() == 0x400c000000000000 as u64);
    assert(numeric_divide_int(-7, -2) == 3);
    // xsd:double("1") / xsd:double("7") -> bits 0x3fc2492492492492 as u64
    assert(numeric_divide_int_as_double(1, 7).to_bits() == 0x3fc2492492492492 as u64);
    assert(numeric_divide_int(1, 7) == 0);
    // xsd:double("2") / xsd:double("3") -> bits 0x3fe5555555555555 as u64
    assert(numeric_divide_int_as_double(2, 3).to_bits() == 0x3fe5555555555555 as u64);
    assert(numeric_divide_int(2, 3) == 0);
    // xsd:double("100") / xsd:double("7") -> bits 0x402c924924924925 as u64
    assert(numeric_divide_int_as_double(100, 7).to_bits() == 0x402c924924924925 as u64);
    assert(numeric_divide_int(100, 7) == 14);
    // xsd:double("0") / xsd:double("5") -> bits 0x0000000000000000 as u64
    assert(numeric_divide_int_as_double(0, 5).to_bits() == 0x0000000000000000 as u64);
    assert(numeric_divide_int(0, 5) == 0);
}

/// fn:round for xs:double — ties toward +INFINITY (F&O 4.4.3), sign of zero
/// preserved. Oracle: SPARQL `ROUND`, bit-cross-checked against the F&O reference. The
/// -0.5 row is SPEC-REFERENCE (see the header): sparq-engine loses the sign of a zero
/// result, so its expected value is F&O's and it asserts noir_XPath against the SPEC.
#[test]
fn differential_oracle_round_double() {
    // ROUND(xsd:double("2.5")) -> 3.0
    assert(round_double(XsdDouble::from_bits(0x4004000000000000 as u64)).to_bits() == 0x4008000000000000 as u64);
    // ROUND(xsd:double("-2.5")) -> -2.0
    assert(round_double(XsdDouble::from_bits(0xc004000000000000 as u64)).to_bits() == 0xc000000000000000 as u64);
    // ROUND(xsd:double("0.5")) -> 1.0
    assert(round_double(XsdDouble::from_bits(0x3fe0000000000000 as u64)).to_bits() == 0x3ff0000000000000 as u64);
    // ROUND(xsd:double("1.5")) -> 2.0
    assert(round_double(XsdDouble::from_bits(0x3ff8000000000000 as u64)).to_bits() == 0x4000000000000000 as u64);
    // ROUND(xsd:double("-1.5")) -> -1.0
    assert(round_double(XsdDouble::from_bits(0xbff8000000000000 as u64)).to_bits() == 0xbff0000000000000 as u64);
    // ROUND(xsd:double("2.4999")) -> 2.0
    assert(round_double(XsdDouble::from_bits(0x4003ffcb923a29c7 as u64)).to_bits() == 0x4000000000000000 as u64);
    // SPEC-REFERENCE: sparq-engine returns +0.0 (bits 0x0000000000000000); F&O 4.4.3
    // requires NEGATIVE zero for an argument in [-0.5, 0). The row asserts the SPEC
    // value LIVE — it holds noir_XPath to F&O, not to sparq. Drop the special-casing
    // (not the assertion) when the engine is fixed.
    // ROUND(xsd:double("-0.5")) -> -0.0
    assert(round_double(XsdDouble::from_bits(0xbfe0000000000000 as u64)).to_bits() == 0x8000000000000000 as u64);
    // ROUND(xsd:double("0")) -> 0.0
    assert(round_double(XsdDouble::from_bits(0x0000000000000000 as u64)).to_bits() == 0x0000000000000000 as u64);
    // ROUND(xsd:double("-3")) -> -3.0
    assert(round_double(XsdDouble::from_bits(0xc008000000000000 as u64)).to_bits() == 0xc008000000000000 as u64);
}

/// Mixed xs:integer <-> xs:double comparison. Every integer here is OUTSIDE the i8
/// range the pre-sq-3x7dl.5 circuit truncated to (which made `256 = 0.0` TRUE — a
/// wrong FILTER verdict an adversarial prover could satisfy). Oracle: SPARQL
/// relational operators, which promote the integer to double per XPath B.1.
#[test]
fn differential_oracle_mixed_compare() {
    let d0 = XsdDouble::from_bits(0x0000000000000000 as u64);
    // 256 = 0 -> false
    assert(compare_int_double_eq(256, d0) == false);
    // 0 = 256 -> false
    assert(compare_double_int_eq(d0, 256) == false);
    // 256 < 0 -> false
    assert(compare_int_double_lt(256, d0) == false);
    // 0 < 256 -> true
    assert(compare_double_int_lt(d0, 256) == true);
    // 256 > 0 -> true
    assert(compare_int_double_gt(256, d0) == true);
    // 0 > 256 -> false
    assert(compare_double_int_gt(d0, 256) == false);
    // 256 <= 0 -> false
    assert(compare_int_double_le(256, d0) == false);
    // 0 <= 256 -> true
    assert(compare_double_int_le(d0, 256) == true);
    // 256 >= 0 -> true
    assert(compare_int_double_ge(256, d0) == true);
    // 0 >= 256 -> false
    assert(compare_double_int_ge(d0, 256) == false);
    let d1 = XsdDouble::from_bits(0x4070000000000000 as u64);
    // 256 = 256 -> true
    assert(compare_int_double_eq(256, d1) == true);
    // 256 = 256 -> true
    assert(compare_double_int_eq(d1, 256) == true);
    // 256 < 256 -> false
    assert(compare_int_double_lt(256, d1) == false);
    // 256 < 256 -> false
    assert(compare_double_int_lt(d1, 256) == false);
    // 256 > 256 -> false
    assert(compare_int_double_gt(256, d1) == false);
    // 256 > 256 -> false
    assert(compare_double_int_gt(d1, 256) == false);
    // 256 <= 256 -> true
    assert(compare_int_double_le(256, d1) == true);
    // 256 <= 256 -> true
    assert(compare_double_int_le(d1, 256) == true);
    // 256 >= 256 -> true
    assert(compare_int_double_ge(256, d1) == true);
    // 256 >= 256 -> true
    assert(compare_double_int_ge(d1, 256) == true);
    let d2 = XsdDouble::from_bits(0xc060200000000000 as u64);
    // -129 = -129 -> true
    assert(compare_int_double_eq(-129, d2) == true);
    // -129 = -129 -> true
    assert(compare_double_int_eq(d2, -129) == true);
    // -129 < -129 -> false
    assert(compare_int_double_lt(-129, d2) == false);
    // -129 < -129 -> false
    assert(compare_double_int_lt(d2, -129) == false);
    // -129 > -129 -> false
    assert(compare_int_double_gt(-129, d2) == false);
    // -129 > -129 -> false
    assert(compare_double_int_gt(d2, -129) == false);
    // -129 <= -129 -> true
    assert(compare_int_double_le(-129, d2) == true);
    // -129 <= -129 -> true
    assert(compare_double_int_le(d2, -129) == true);
    // -129 >= -129 -> true
    assert(compare_int_double_ge(-129, d2) == true);
    // -129 >= -129 -> true
    assert(compare_double_int_ge(d2, -129) == true);
    let d3 = XsdDouble::from_bits(0x4060000000000000 as u64);
    // 128 = 128 -> true
    assert(compare_int_double_eq(128, d3) == true);
    // 128 = 128 -> true
    assert(compare_double_int_eq(d3, 128) == true);
    // 128 < 128 -> false
    assert(compare_int_double_lt(128, d3) == false);
    // 128 < 128 -> false
    assert(compare_double_int_lt(d3, 128) == false);
    // 128 > 128 -> false
    assert(compare_int_double_gt(128, d3) == false);
    // 128 > 128 -> false
    assert(compare_double_int_gt(d3, 128) == false);
    // 128 <= 128 -> true
    assert(compare_int_double_le(128, d3) == true);
    // 128 <= 128 -> true
    assert(compare_double_int_le(d3, 128) == true);
    // 128 >= 128 -> true
    assert(compare_int_double_ge(128, d3) == true);
    // 128 >= 128 -> true
    assert(compare_double_int_ge(d3, 128) == true);
    let d4 = XsdDouble::from_bits(0x4060000000000000 as u64);
    // 384 = 128 -> false
    assert(compare_int_double_eq(384, d4) == false);
    // 128 = 384 -> false
    assert(compare_double_int_eq(d4, 384) == false);
    // 384 < 128 -> false
    assert(compare_int_double_lt(384, d4) == false);
    // 128 < 384 -> true
    assert(compare_double_int_lt(d4, 384) == true);
    // 384 > 128 -> true
    assert(compare_int_double_gt(384, d4) == true);
    // 128 > 384 -> false
    assert(compare_double_int_gt(d4, 384) == false);
    // 384 <= 128 -> false
    assert(compare_int_double_le(384, d4) == false);
    // 128 <= 384 -> true
    assert(compare_double_int_le(d4, 384) == true);
    // 384 >= 128 -> true
    assert(compare_int_double_ge(384, d4) == true);
    // 128 >= 384 -> false
    assert(compare_double_int_ge(d4, 384) == false);
    let d5 = XsdDouble::from_bits(0x4340000000000000 as u64);
    // 9007199254740993 = 9007199254740992 -> true
    assert(compare_int_double_eq(9007199254740993, d5) == true);
    // 9007199254740992 = 9007199254740993 -> true
    assert(compare_double_int_eq(d5, 9007199254740993) == true);
    // 9007199254740993 < 9007199254740992 -> false
    assert(compare_int_double_lt(9007199254740993, d5) == false);
    // 9007199254740992 < 9007199254740993 -> false
    assert(compare_double_int_lt(d5, 9007199254740993) == false);
    // 9007199254740993 > 9007199254740992 -> false
    assert(compare_int_double_gt(9007199254740993, d5) == false);
    // 9007199254740992 > 9007199254740993 -> false
    assert(compare_double_int_gt(d5, 9007199254740993) == false);
    // 9007199254740993 <= 9007199254740992 -> true
    assert(compare_int_double_le(9007199254740993, d5) == true);
    // 9007199254740992 <= 9007199254740993 -> true
    assert(compare_double_int_le(d5, 9007199254740993) == true);
    // 9007199254740993 >= 9007199254740992 -> true
    assert(compare_int_double_ge(9007199254740993, d5) == true);
    // 9007199254740992 >= 9007199254740993 -> true
    assert(compare_double_int_ge(d5, 9007199254740993) == true);
    let d6 = XsdDouble::from_bits(0x412e847f00000000 as u64);
    // 1000000 = 999999.5 -> false
    assert(compare_int_double_eq(1000000, d6) == false);
    // 999999.5 = 1000000 -> false
    assert(compare_double_int_eq(d6, 1000000) == false);
    // 1000000 < 999999.5 -> false
    assert(compare_int_double_lt(1000000, d6) == false);
    // 999999.5 < 1000000 -> true
    assert(compare_double_int_lt(d6, 1000000) == true);
    // 1000000 > 999999.5 -> true
    assert(compare_int_double_gt(1000000, d6) == true);
    // 999999.5 > 1000000 -> false
    assert(compare_double_int_gt(d6, 1000000) == false);
    // 1000000 <= 999999.5 -> false
    assert(compare_int_double_le(1000000, d6) == false);
    // 999999.5 <= 1000000 -> true
    assert(compare_double_int_le(d6, 1000000) == true);
    // 1000000 >= 999999.5 -> true
    assert(compare_int_double_ge(1000000, d6) == true);
    // 999999.5 >= 1000000 -> false
    assert(compare_double_int_ge(d6, 1000000) == false);
    let d7 = XsdDouble::from_bits(0x0000000000000000 as u64);
    // -1000000 = 0 -> false
    assert(compare_int_double_eq(-1000000, d7) == false);
    // 0 = -1000000 -> false
    assert(compare_double_int_eq(d7, -1000000) == false);
    // -1000000 < 0 -> true
    assert(compare_int_double_lt(-1000000, d7) == true);
    // 0 < -1000000 -> false
    assert(compare_double_int_lt(d7, -1000000) == false);
    // -1000000 > 0 -> false
    assert(compare_int_double_gt(-1000000, d7) == false);
    // 0 > -1000000 -> true
    assert(compare_double_int_gt(d7, -1000000) == true);
    // -1000000 <= 0 -> true
    assert(compare_int_double_le(-1000000, d7) == true);
    // 0 <= -1000000 -> false
    assert(compare_double_int_le(d7, -1000000) == false);
    // -1000000 >= 0 -> false
    assert(compare_int_double_ge(-1000000, d7) == false);
    // 0 >= -1000000 -> true
    assert(compare_double_int_ge(d7, -1000000) == true);
}

/// xs:integer(xs:double) — TRUNCATES toward zero (F&O 17.1.1); it does NOT round.
/// Oracle: SPARQL `xsd:integer(xsd:double(...))`.
#[test]
fn differential_oracle_double_to_integer_cast() {
    // xsd:integer(xsd:double("3.9")) -> 3
    assert(cast_double_to_integer(XsdDouble::from_bits(0x400f333333333333 as u64)).unwrap() == 3);
    // xsd:integer(xsd:double("-3.9")) -> -3
    assert(cast_double_to_integer(XsdDouble::from_bits(0xc00f333333333333 as u64)).unwrap() == -3);
    // xsd:integer(xsd:double("0")) -> 0
    assert(cast_double_to_integer(XsdDouble::from_bits(0x0000000000000000 as u64)).unwrap() == 0);
    // xsd:integer(xsd:double("-0.5")) -> 0
    assert(cast_double_to_integer(XsdDouble::from_bits(0xbfe0000000000000 as u64)).unwrap() == 0);
    // xsd:integer(xsd:double("2.5")) -> 2
    assert(cast_double_to_integer(XsdDouble::from_bits(0x4004000000000000 as u64)).unwrap() == 2);
    // xsd:integer(xsd:double("9007199254740992")) -> 9007199254740992
    assert(cast_double_to_integer(XsdDouble::from_bits(0x4340000000000000 as u64)).unwrap() == 9007199254740992);
    // xsd:integer(xsd:double("-2.5")) -> -2
    assert(cast_double_to_integer(XsdDouble::from_bits(0xc004000000000000 as u64)).unwrap() == -2);
}

/// Pre-1970 xs:dateTime. The epoch is a SIGNED microsecond count; the pre-sq-3x7dl.7
/// circuit cast it through u64 and corrupted every extracted component. Oracle:
/// SPARQL YEAR/MONTH/DAY/HOURS/MINUTES/SECONDS over the parsed lexical.
#[test]
fn differential_oracle_datetime_pre_1970() {
    // xsd:dateTime("1969-07-20T20:17:40Z")
    let dt0 = datetime_from_components(1969, 7, 20, 20, 17, 40, 0);
    assert(year_from_datetime(dt0) == 1969);
    assert(month_from_datetime(dt0) == 7);
    assert(day_from_datetime(dt0) == 20);
    assert(hours_from_datetime(dt0) == 20);
    assert(minutes_from_datetime(dt0) == 17);
    assert(seconds_from_datetime(dt0) == 40);
    // xsd:dateTime("1901-12-13T20:45:52Z")
    let dt1 = datetime_from_components(1901, 12, 13, 20, 45, 52, 0);
    assert(year_from_datetime(dt1) == 1901);
    assert(month_from_datetime(dt1) == 12);
    assert(day_from_datetime(dt1) == 13);
    assert(hours_from_datetime(dt1) == 20);
    assert(minutes_from_datetime(dt1) == 45);
    assert(seconds_from_datetime(dt1) == 52);
    // xsd:dateTime("1969-12-31T23:59:59Z")
    let dt2 = datetime_from_components(1969, 12, 31, 23, 59, 59, 0);
    assert(year_from_datetime(dt2) == 1969);
    assert(month_from_datetime(dt2) == 12);
    assert(day_from_datetime(dt2) == 31);
    assert(hours_from_datetime(dt2) == 23);
    assert(minutes_from_datetime(dt2) == 59);
    assert(seconds_from_datetime(dt2) == 59);
    // xsd:dateTime("1970-01-01T00:00:00Z")
    let dt3 = datetime_from_components(1970, 1, 1, 0, 0, 0, 0);
    assert(year_from_datetime(dt3) == 1970);
    assert(month_from_datetime(dt3) == 1);
    assert(day_from_datetime(dt3) == 1);
    assert(hours_from_datetime(dt3) == 0);
    assert(minutes_from_datetime(dt3) == 0);
    assert(seconds_from_datetime(dt3) == 0);
    // xsd:dateTime("1970-01-01T00:00:01Z")
    let dt4 = datetime_from_components(1970, 1, 1, 0, 0, 1, 0);
    assert(year_from_datetime(dt4) == 1970);
    assert(month_from_datetime(dt4) == 1);
    assert(day_from_datetime(dt4) == 1);
    assert(hours_from_datetime(dt4) == 0);
    assert(minutes_from_datetime(dt4) == 0);
    assert(seconds_from_datetime(dt4) == 1);
    // xsd:dateTime("1968-02-29T12:00:00Z")
    let dt5 = datetime_from_components(1968, 2, 29, 12, 0, 0, 0);
    assert(year_from_datetime(dt5) == 1968);
    assert(month_from_datetime(dt5) == 2);
    assert(day_from_datetime(dt5) == 29);
    assert(hours_from_datetime(dt5) == 12);
    assert(minutes_from_datetime(dt5) == 0);
    assert(seconds_from_datetime(dt5) == 0);
    // xsd:dateTime("2024-06-15T08:09:10Z")
    let dt6 = datetime_from_components(2024, 6, 15, 8, 9, 10, 0);
    assert(year_from_datetime(dt6) == 2024);
    assert(month_from_datetime(dt6) == 6);
    assert(day_from_datetime(dt6) == 15);
    assert(hours_from_datetime(dt6) == 8);
    assert(minutes_from_datetime(dt6) == 9);
    assert(seconds_from_datetime(dt6) == 10);
    // Signed ordering across the 1970 epoch boundary.
    assert(datetime_less_than(dt0, dt3) == true);
}

// Coverage: 250 live assertions, 9 of them SPEC-REFERENCE rows whose expected value is
// XPath F&O's rather than the oracle's (recorded oracle divergences; 0 commented out).
