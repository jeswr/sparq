// [OPUS-4.8] sq-xqfg (HolderPoP T5): in-circuit holder Proof-of-Possession (the
// B2 hidden-key tier). Re-review when Fable returns.
//! In-circuit **holder Proof-of-Possession** over Baby-JubJub (design
//! `research/zk-holder-pop-design.md` S2.B/B2, S3.4): prove, in zero knowledge,
//! knowledge of a holder secret `hsk` whose public key `hpk = hsk*G` matches the
//! issuer-attested holder-key digest the verifier folds into the
//! `commitment_message_with_holder` signature -- WITHOUT disclosing `hsk` (and,
//! for the hidden-holder tier, without disclosing `hpk` either: only the digest
//! is public).
//!
//! # The statement
//!   PUBLIC:  `challenge` (verifier nonce, replay binding S2.5),
//!            `holder_pk_digest` (the issuer-attested holder-key digest)
//!   PRIVATE: `hsk` (holder secret scalar), `hpk` (holder public key affine point)
//!
//!   "I know `hsk < L` and a point `hpk` on Baby-JubJub such that
//!      (1) `hpk = hsk*G`                                  (key-pair relation), and
//!      (2) `Poseidon2([ZKSIG_HK, hpk.x, hpk.y]) == holder_pk_digest`
//!                                                         (issuer-attested digest)."
//!
//! # Why this closes the trusted-holder gap (G1, design S4.1/B2)
//! The PUBLIC `holder_pk_digest` is the one the verifier recovered from B's
//! issuer-signed `commitment_message_with_holder` (T6/sq-i1dt binds it; NOT this
//! bead). A prover can only produce a satisfying witness if it knows `hsk` with
//! `hsk*G = hpk_B` (the issuer-bound key). DL-hardness on Baby-JubJub + proof
//! soundness => a malicious holder A who does NOT hold `hsk_B` cannot forge the
//! proof, and A cannot substitute its own `hpk_A` because the digest equality
//! would then disagree with the verifier-bound `holder_pk_digest`.
//!
//! # Cheaper than `schnorr_verify` (design S5)
//! This is ONE ~251-bit Baby-JubJub double-and-add scalar-mul (`hsk*G`) plus a
//! Poseidon2 digest -- strictly *cheaper* than `issuer.nr::schnorr_verify`, which
//! does TWO scalar-muls (`s*G` and `e*pk`). Every gadget below is reused VERBATIM
//! from `issuer.nr` (`scalar_mul`, `assert_on_curve`, `assert_lt_l`, the `Point`
//! type, the `BJJ_*` generator/order constants); only the Poseidon2 holder-key
//! digest (`holder_pk_digest`, the `ZKSIG_HK` domain tag) is added here.
//!
//! # Digest bit-compatibility (SECURITY-critical, design S4.3)
//! `holder_pk_digest` MUST equal the host-side `sparq_zk::sig::holder_key_digest`
//! for the same key -- `Poseidon2([ZKSIG_HK, hpk.x, hpk.y])` with the SAME domain
//! tag `ZKSIG_HK = 0x5a4b_5349_475f_484b`. T6's verifier gate cross-checks the
//! in-circuit public digest against the host digest recovered from the issuer
//! attestation, so a drift here would break that cross-check. Pinned by the
//! `holder_key_digest_cross_vector` / `holder_pok_*` tests in `tests.nr`
//! (generated by `sparq_zk_compose::holder` from a REAL `holder_key_digest`).

use crate::hashes::h2;
use crate::issuer::{assert_lt_l, assert_on_curve, scalar_mul, BJJ_GX, BJJ_GY};
use poseidon::poseidon2::Poseidon2;

// Re-export the affine point type so the `holder_pok` member imports it from this
// module (the same `Point` `issuer.nr` defines -- one source of truth for the
// curve coordinate pair).
pub use crate::issuer::Point;

// Domain separator for the holder-public-key digest -- MUST equal
// `sparq_zk::sig::SIG_DOMAIN_HOLDER_KEY` ("ZKSIG_HK" = 0x5a4b5349475f484b), the
// tag `holder_key_digest` folds, so the in-circuit digest is bit-identical to the
// host's. Distinct from `SIG_DOMAIN_COMMITMENT` ("ZKSIG_C1") so a holder-key
// digest can never be confused with a commitment-challenge value.
pub global SIG_DOMAIN_HOLDER_KEY: Field = 0x5a4b5349475f484b;

/// The holder-public-key digest, bit-identical to `sparq_zk::sig::holder_key_digest`:
/// `Poseidon2([ZKSIG_HK, hpk.x, hpk.y], 3)`. (NOT the `h2(x, y)` key-set leaf shape
/// `issuer.nr::key_leaf` uses -- the domain tag prepended here keeps the two digests
/// distinct over the same coordinates.)
pub fn holder_key_digest(hpk: Point) -> Field {
    Poseidon2::hash([SIG_DOMAIN_HOLDER_KEY, hpk.x, hpk.y], 3)
}

/// The in-circuit holder Proof-of-Possession relation (design S3.4). Proves
/// knowledge of `hsk` such that `hpk = hsk*G` AND
/// `holder_key_digest(hpk) == holder_pk_digest`.
///
/// PUBLIC (caller-bound, via the member `main`):
///   - `holder_pk_digest` -- the issuer-attested holder-key digest.
///   - (`challenge` is bound by the proof's public inputs at the `main` level;
///     it carries no relation constraint, exactly as in `hidden_issuer_d4`.)
/// PRIVATE:
///   - `hsk` -- the holder secret scalar (canonical, `< L`).
///   - `hpk` -- the holder public key affine point (HIDDEN in the hidden-holder
///     tier; the verifier binds only `holder_pk_digest`).
///
/// Asserts:
///   1. `hpk` is on Baby-JubJub (off-curve / twist forgery guard, like
///      `schnorr_verify`'s `assert_on_curve`).
///   2. `hpk` is not the neutral `(0, 1)`: the identity key is `hsk*G` only for
///      `hsk == 0 (mod L)`, a degenerate "key" with no possession secret -- reject
///      it (the same universal-forgery guard `schnorr_verify` applies to the
///      issuer key).
///   3. `hsk < L` (canonical scalar; also the `to_le_bits::<SCALAR_BITS>` range
///      bound `scalar_mul` relies on for `hsk*G`).
///   4. `hpk == hsk*G` (the key-pair relation -- possession of `hsk`).
///   5. `holder_key_digest(hpk) == holder_pk_digest` (the issuer-attested binding).
pub fn holder_pok(holder_pk_digest: Field, hsk: Field, hpk: Point) {
    // (1) on-curve guard for the private holder key.
    assert_on_curve(hpk);
    // (2) reject the identity holder key (neutral (0,1)): it corresponds to
    // hsk == 0 mod L and carries no possession secret.
    assert(!((hpk.x == 0) & (hpk.y == 1)), "identity holder key rejected");
    // (3) hsk canonical (< L). This is also the range bound scalar_mul needs.
    assert_lt_l(hsk);
    // (4) hpk == hsk*G (one Baby-JubJub scalar-mul -- half of schnorr_verify).
    let g = Point { x: BJJ_GX, y: BJJ_GY };
    let derived = scalar_mul(hsk, g);
    assert((derived.x == hpk.x) & (derived.y == hpk.y), "holder key mismatch");
    // (5) the issuer-attested digest binding (matches the host holder_key_digest).
    assert(holder_key_digest(hpk) == holder_pk_digest, "holder digest mismatch");
}

// [OPUS-4.8] sq-3c00 (HolderPoP hidden-holder-SET tier): prove the holder is a
// member of a holder SET committed as a Poseidon2 Merkle root, WITHOUT revealing
// WHICH holder. The analogue of `issuer.nr::key_set_membership` / the
// `hidden_issuer_d{D}` member, reusing the SAME `h2`-folded Merkle gadget pattern
// (one source of truth for the tree shape: `hashes::h2` internal nodes, the
// revocation/key-set tree). Re-review when Fable returns.
//
// # The statement (depth-D)
//   PUBLIC:  `challenge` (verifier nonce), `holder_set_root` (the committed set's
//            Poseidon2 Merkle root)
//   PRIVATE: `hsk` (holder secret), `hpk` (holder public key), `index` (the
//            holder's hidden slot in the set), `siblings` (the authentication path)
//
//   "I know `hsk < L` and a point `hpk` on Baby-JubJub such that `hpk = hsk*G`, and
//    the holder-key digest `holder_key_digest(hpk)` is a member of the set committed
//    as `holder_set_root` at the hidden `index`."
//
// # Why this is the holder analogue of hidden_issuer (NOT the clear-digest tier)
// `holder_pok` (above) makes the issuer-attested `holder_pk_digest` PUBLIC, so a
// verifier learns the holder is the SPECIFIC (hidden-key) party bound to ONE
// credential. This tier instead hides WHICH holder: the digest stays PRIVATE and
// only set-membership is proved, exactly as `hidden_issuer` hides WHICH issuer by
// publishing `key_set_root` instead of the issuer key. The leaf committed here is
// the holder-key DIGEST `holder_key_digest(hpk) = Poseidon2([ZKSIG_HK, hpk.x,
// hpk.y])` (the canonical attested holder identity), NOT the raw `h2(x, y)` shape
// `issuer.nr::key_leaf` uses for the issuer set -- the host `holder_set_root` /
// `holder_set_membership_witness` commit the same digest leaf.

/// The Merkle leaf for a holder in the holder set: its holder-key digest
/// `holder_key_digest(hpk)`. The Rust host mirror commits the same leaf, so the
/// set root is recomputable bit-for-bit verifier-side from the relying party's
/// authoritative holder registry.
pub fn holder_set_leaf(hpk: Point) -> Field {
    holder_key_digest(hpk)
}

/// Hidden-holder set membership: prove the PRIVATE holder key `hpk`'s digest is a
/// member of the set committed as the depth-`D` Poseidon2 Merkle root
/// `holder_set_root` (PUBLIC), at a PRIVATE `index` along a PRIVATE authentication
/// path `siblings`. Identical fold discipline to `issuer.nr::key_set_membership`
/// and `revoke::revoke_unset_check`: the leaf is `holder_set_leaf(hpk)`, the
/// directions are the bits of `index` (so a prover cannot reuse another member's
/// path under a different claimed index), and the fold must recompute the public
/// root.
pub fn holder_set_membership<let D: u32>(
    hpk: Point,
    holder_set_root: Field,
    index: Field,
    siblings: [Field; D],
) {
    let leaf = holder_set_leaf(hpk);
    // Decompose index to exactly D bits in-circuit: directions = index bits, and
    // index < 2^D (in-range for the tree). Same discipline as issuer.nr / revoke.nr.
    let dirs: [bool; D] = index.to_le_bits();
    let mut node = leaf;
    for k in 0..D {
        let sib = siblings[k];
        let is_right = dirs[k];
        let left = if is_right { sib } else { node };
        let right = if is_right { node } else { sib };
        node = h2(left, right);
    }
    assert(node == holder_set_root, "holder is not a member of the committed holder set");
}

/// The full hidden-holder-SET relation (design S4.1/B2, the hidden-holder analogue
/// of `issuer.nr::hidden_issuer_attestation`): the PRIVATE holder key `hpk`
/// (1) is the public key of the PRIVATE holder secret `hsk` (`hpk = hsk*G`,
/// possession of `hsk`), is on-curve, non-identity, and `hsk < L`, AND
/// (2) its holder-key digest is a member of the set committed as the PUBLIC
/// `holder_set_root`. Proves "I am SOME holder in the set" without revealing which.
///
/// PUBLIC:  `holder_set_root`.
/// PRIVATE: `hsk`, `hpk`, `index`, `siblings`.
///
/// Reuses `holder_pok`'s on-curve / identity / `< L` / `hpk = hsk*G` checks
/// verbatim (steps 1-4) and swaps the clear-digest binding (step 5) for the
/// hidden Merkle-membership fold. `holder_pk_digest` is NOT a public input here:
/// the verifier binds only `holder_set_root` (the committed set), so WHICH holder
/// is never disclosed.
pub fn hidden_holder_set<let D: u32>(
    // -- public --
    holder_set_root: Field,
    // -- private --
    hsk: Field,
    hpk: Point,
    index: Field,
    siblings: [Field; D],
) {
    // (1) on-curve guard for the private holder key.
    assert_on_curve(hpk);
    // (2) reject the identity holder key (neutral (0,1)): hsk == 0 mod L, no secret.
    assert(!((hpk.x == 0) & (hpk.y == 1)), "identity holder key rejected");
    // (3) hsk canonical (< L) -- also the range bound scalar_mul needs.
    assert_lt_l(hsk);
    // (4) hpk == hsk*G (possession of the holder secret).
    let g = Point { x: BJJ_GX, y: BJJ_GY };
    let derived = scalar_mul(hsk, g);
    assert((derived.x == hpk.x) & (derived.y == hpk.y), "holder key mismatch");
    // (5) membership of the holder-key digest in the committed set (hides WHICH).
    holder_set_membership::<D>(hpk, holder_set_root, index, siblings);
}
