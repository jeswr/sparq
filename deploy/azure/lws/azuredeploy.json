{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "16013827280920148135"
    },
    "gpt56Review": "[GPT-5.6] Corrected by the stronger-tier IaC security review.",
    "securityNotice": "The sibling sparq-server image is open-by-default; its Azure template gates it with a Key Vault token. Do not remove the token wiring."
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "sparq-lws-env",
      "metadata": {
        "description": "Container Apps Environment name."
      }
    },
    "containerAppName": {
      "type": "string",
      "defaultValue": "sparq-lws",
      "metadata": {
        "description": "Container App name."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region."
      }
    },
    "imageRef": {
      "type": "string",
      "defaultValue": "ghcr.io/sparq-org/sparq-lws-core:latest",
      "metadata": {
        "description": "Full image reference. Activates once sq-lmz40 ships."
      }
    },
    "solidBaseUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional public HTTPS base URL override (without a trailing slash) for a configured custom domain. Empty derives the managed URL."
      }
    },
    "livenessPath": {
      "type": "string",
      "defaultValue": "/livez",
      "minLength": 1,
      "metadata": {
        "description": "HTTP path used by the liveness and startup probes (R7)."
      }
    },
    "readinessPath": {
      "type": "string",
      "defaultValue": "/readyz",
      "minLength": 1,
      "metadata": {
        "description": "HTTP path used by the readiness probe (R7)."
      }
    },
    "solidTrustedIssuer": {
      "type": "string",
      "minLength": 9,
      "metadata": {
        "description": "  Trusted OIDC issuer URL for the Solid/LWS server (e.g. https://inrupt.net).\nREQUIRED and HTTPS-only. The server rejects authentication without a trusted issuer. (§1.3)\n"
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 0,
      "maxValue": 1,
      "metadata": {
        "description": "Minimum replica count. May be zero for scale-to-zero; maximum replicas is always one."
      }
    },
    "cpuCores": {
      "type": "string",
      "defaultValue": "0.5",
      "allowedValues": [
        "0.25",
        "0.5",
        "0.75",
        "1.0",
        "1.25",
        "1.5",
        "1.75",
        "2.0"
      ],
      "metadata": {
        "description": "CPU allocation per replica. Memory is derived to keep a valid Container Apps consumption profile."
      }
    }
  },
  "variables": {
    "memoryByCpu": {
      "0.25": "0.5Gi",
      "0.5": "1Gi",
      "0.75": "1.5Gi",
      "1.0": "2Gi",
      "1.25": "2.5Gi",
      "1.5": "3Gi",
      "1.75": "3.5Gi",
      "2.0": "4Gi"
    },
    "trustedIssuer": "[if(startsWith(parameters('solidTrustedIssuer'), 'https://'), parameters('solidTrustedIssuer'), fail('solidTrustedIssuer must use https://.'))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[take(format('{0}-logs', parameters('environmentName')), 63)]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('environmentName')]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', take(format('{0}-logs', parameters('environmentName')), 63)), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', take(format('{0}-logs', parameters('environmentName')), 63)), '2022-10-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', take(format('{0}-logs', parameters('environmentName')), 63))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 3000,
            "transport": "http",
            "allowInsecure": false
          }
        },
        "template": {
          "containers": [
            {
              "name": "sparq-lws",
              "image": "[parameters('imageRef')]",
              "resources": {
                "cpu": "[json(parameters('cpuCores'))]",
                "memory": "[variables('memoryByCpu')[parameters('cpuCores')]]"
              },
              "env": [
                {
                  "name": "SOLID_SERVER_BASE_URL",
                  "value": "[if(empty(parameters('solidBaseUrl')), format('https://{0}.{1}', parameters('containerAppName'), reference(resourceId('Microsoft.App/managedEnvironments', parameters('environmentName')), '2024-03-01').defaultDomain), if(startsWith(parameters('solidBaseUrl'), 'https://'), parameters('solidBaseUrl'), fail('solidBaseUrl must use https:// when supplied.')))]"
                },
                {
                  "name": "SOLID_SERVER_TRUSTED_ISSUER",
                  "value": "[variables('trustedIssuer')]"
                },
                {
                  "name": "SOLID_SERVER_AUDIENCE",
                  "value": "[if(empty(parameters('solidBaseUrl')), format('https://{0}.{1}', parameters('containerAppName'), reference(resourceId('Microsoft.App/managedEnvironments', parameters('environmentName')), '2024-03-01').defaultDomain), if(startsWith(parameters('solidBaseUrl'), 'https://'), parameters('solidBaseUrl'), fail('solidBaseUrl must use https:// when supplied.')))]"
                },
                {
                  "name": "SOLID_SERVER_BIND",
                  "value": "0.0.0.0:3000"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "[parameters('livenessPath')]",
                    "port": 3000
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 30,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "[parameters('readinessPath')]",
                    "port": 3000
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 3
                },
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "[parameters('livenessPath')]",
                    "port": 3000
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 6,
                  "failureThreshold": 10
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]"
      ]
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2024-03-01').configuration.ingress.fqdn]"
    },
    "solidEndpoint": {
      "type": "string",
      "value": "[format('{0}/', if(empty(parameters('solidBaseUrl')), format('https://{0}.{1}', parameters('containerAppName'), reference(resourceId('Microsoft.App/managedEnvironments', parameters('environmentName')), '2024-03-01').defaultDomain), if(startsWith(parameters('solidBaseUrl'), 'https://'), parameters('solidBaseUrl'), fail('solidBaseUrl must use https:// when supplied.'))))]"
    }
  }
}