{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "_comment": "[SONNET-4.6] sq-zcou4 — ARM template compiled from main.bicep for the Deploy-to-Azure button flow. See main.bicep for full commentary. Do not edit this file directly — edit main.bicep and recompile with: az bicep build --file main.bicep",
  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "sparq-server-env",
      "metadata": { "description": "Container Apps Environment name." }
    },
    "containerAppName": {
      "type": "string",
      "defaultValue": "sparq-server",
      "metadata": { "description": "Container App name." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region." }
    },
    "imageRef": {
      "type": "string",
      "defaultValue": "ghcr.io/sparq-org/sparq-server:latest",
      "metadata": { "description": "Full image reference (registry/image:tag). Pin a specific version in production." }
    },
    "authToken": {
      "type": "securestring",
      "metadata": { "description": "SPARQ_AUTH_TOKEN bearer value — REQUIRED. Store via Key Vault reference or CLI --parameters. Never a literal in this file. (R1/R4)" }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 0,
      "maxValue": 25,
      "metadata": { "description": "Minimum replica count." }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 3,
      "minValue": 1,
      "maxValue": 25,
      "metadata": { "description": "Maximum replica count." }
    },
    "authTokenRead": {
      "type": "string",
      "defaultValue": "",
      "allowedValues": ["", "1"],
      "metadata": { "description": "Set to '1' to require token for reads too." }
    },
    "corsAllowOrigin": {
      "type": "string",
      "defaultValue": "",
      "metadata": { "description": "SPARQ_CORS_ALLOW_ORIGIN value. Empty = disabled." }
    },
    "maxConcurrent": {
      "type": "int",
      "defaultValue": 16,
      "minValue": 1,
      "maxValue": 256,
      "metadata": { "description": "SPARQ_MAX_CONCURRENT — max concurrent query workers." }
    },
    "queryTimeoutSeconds": {
      "type": "int",
      "defaultValue": 30,
      "minValue": 5,
      "maxValue": 300,
      "metadata": { "description": "SPARQ_QUERY_TIMEOUT — per-query timeout in seconds." }
    },
    "cpuCores": {
      "type": "string",
      "defaultValue": "0.5",
      "metadata": { "description": "CPU allocation per replica (e.g. 0.5, 1.0)." }
    },
    "memory": {
      "type": "string",
      "defaultValue": "1Gi",
      "metadata": { "description": "Memory allocation per replica (e.g. 1Gi, 2Gi)." }
    }
  },
  "variables": {
    "identityName": "[concat(parameters('containerAppName'), '-identity')]",
    "logWorkspaceName": "[concat(parameters('environmentName'), '-logs')]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('identityName')]",
      "location": "[parameters('location')]",
      "comments": "User-assigned managed identity — least-privilege identity for the Container App (R5). Grant Key Vault get on the auth-token secret post-deploy."
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[variables('logWorkspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": { "name": "PerGB2018" },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('environmentName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName'))]"
      ],
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName')), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logWorkspaceName')), '2022-10-01').primarySharedKey]"
          }
        }
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ],
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]": {}
        }
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "configuration": {
          "secrets": [
            {
              "name": "sparq-auth-token",
              "value": "[parameters('authToken')]"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 3030,
            "transport": "http",
            "allowInsecure": false
          }
        },
        "template": {
          "containers": [
            {
              "name": "sparq-server",
              "image": "[parameters('imageRef')]",
              "securityContext": {
                "runAsNonRoot": true,
                "readOnlyRootFilesystem": true,
                "allowPrivilegeEscalation": false
              },
              "resources": {
                "cpu": "[json(parameters('cpuCores'))]",
                "memory": "[parameters('memory')]"
              },
              "env": [
                {
                  "name": "SPARQ_AUTH_TOKEN",
                  "secretRef": "sparq-auth-token"
                },
                {
                  "name": "SPARQ_MAX_CONCURRENT",
                  "value": "[string(parameters('maxConcurrent'))]"
                },
                {
                  "name": "SPARQ_QUERY_TIMEOUT",
                  "value": "[string(parameters('queryTimeoutSeconds'))]"
                },
                {
                  "name": "SPARQ_AUTH_TOKEN_READ",
                  "value": "[parameters('authTokenRead')]"
                },
                {
                  "name": "SPARQ_CORS_ALLOW_ORIGIN",
                  "value": "[parameters('corsAllowOrigin')]"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 3030
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 30,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health",
                    "port": 3030
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 3
                },
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/health",
                    "port": 3030
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5,
                  "failureThreshold": 12
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2024-03-01').configuration.ingress.fqdn]"
    },
    "sparqlEndpoint": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2024-03-01').configuration.ingress.fqdn, '/sparql')]"
    },
    "managedIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').clientId]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]"
    }
  }
}
